    "/identity_verifications/{reservationId}/access_logs/{logId}": {
      "schema": { "$ref": "#/entities/IdentityAccessLog" },
      "description": "Immutable traceability log for identity verification operations"
    },
    "/pilot_partners/{pilotId}": {
      "schema": { "$ref": "#/entities/PilotPartner" },
      "description": "Strictly Admin-only confidential CRM, prospection, and conventioning workspace for priority Benin pilot partners"
