      "description": "AMARO PARTNERS influencer and affiliate profiles"
    },
    "/partner_referrals/{referralId}": {
      "schema": { "$ref": "#/entities/PartnerReferral" },
      "description": "Server-validated referral commission records governed by Admin"
    },
    "/notifications/{notificationId}": {
