    "/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Append-only administrative audit logs"
    },
    "/identity_verifications/{reservationId}": {
      "schema": { "$ref": "#/entities/IdentityVerification" },
