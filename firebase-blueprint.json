    "/journey_folders/{folderId}/journal/{entryId}": {
      "schema": { "$ref": "#/entities/JournalEntry" },
      "description": "Electronic Travel Logbook checklist steps, souvenir notes, and progress tracking"
    },
    "/reservations/{reservationId}": {
      "schema": { "$ref": "#/entities/Reservation" },
      "description": "State-machine reservations linking clientId and providerOwnerId"
    },
    "/partners/{partnerId}": {
