rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Zero-Trust Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    // Supports Google verified accounts AND Email/Password accounts (Bloc 6.6)
    // while strictly blocking any unverified claim on the owner admin address.
    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        (
          'firebase' in request.auth.token &&
          'sign_in_provider' in request.auth.token.firebase &&
          request.auth.token.firebase.sign_in_provider == 'password' &&
          request.auth.token.email != 'kayne3200@gmail.com'
        )
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Zero-DB-lookup admin check safe for list queries (Pillar 8 Cost-Optimization Clause)
    function isBootstrappedAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'kayne3200@gmail.com';
    }

    // Full relational admin check for single-document operations
    function isAdmin() {
      return isSignedIn() && (
        isBootstrappedAdmin() ||
        (request.auth.token.email_verified == true && exists(/databases/$(database)/documents/admins/$(request.auth.uid)))
      );
    }

    function isValidCategory(cat) {
      return cat is string && cat in ['accommodation', 'transport', 'restaurant', 'site', 'translation', 'shopping', 'wellness'];
    }

    function isValidCurrency(cur) {
      return cur is string && cur in ['XOF', 'EUR', 'USD'];
    }

    // --- Validation Blueprints ---
    function isValidUserPublic(data) {
      return data.keys().hasAll(['uid', 'displayName', 'accountType', 'preferredLocale', 'preferredCurrency', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'accountType', 'preferredLocale', 'preferredCurrency', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.accountType is string && data.accountType in ['traveler', 'provider']
        && data.preferredLocale is string && data.preferredLocale in ['fr', 'en']
        && isValidCurrency(data.preferredCurrency)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivate(data) {
      return data.keys().hasAll(['uid', 'email', 'phone', 'emergencyContact', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'phone', 'phoneVerified', 'emergencyContact', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 200
        && data.phone is string && data.phone.size() <= 40
        && (!('phoneVerified' in data) || data.phoneVerified is bool)
        && data.emergencyContact is string && data.emergencyContact.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPreferences(data) {
      return data.keys().hasAll([
          'userId', 'consentEnabled', 'preferredStanding', 'travelPace',
          'dietaryNotes', 'favoriteInterests', 'muteNonEssentialNotifications',
          'phoneNumberDeclared', 'phoneVerified', 'updatedAtIso'
        ])
        && data.keys().hasOnly([
          'userId', 'consentEnabled', 'preferredStanding', 'travelPace',
          'dietaryNotes', 'favoriteInterests', 'muteNonEssentialNotifications',
          'phoneNumberDeclared', 'phoneVerified', 'updatedAtIso', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.consentEnabled is bool
        && data.preferredStanding is string && data.preferredStanding.size() <= 80
        && data.travelPace is string && data.travelPace.size() <= 80
        && data.dietaryNotes is string && data.dietaryNotes.size() <= 500
        && data.favoriteInterests is list && data.favoriteInterests.size() <= 25
        && data.muteNonEssentialNotifications is bool
        && data.phoneNumberDeclared is string && data.phoneNumberDeclared.size() <= 40
        && data.phoneVerified is bool
        && data.updatedAtIso is string && data.updatedAtIso.size() <= 40;
    }

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'roleLevel', 'createdAt'])
        && data.keys().hasOnly(['uid', 'roleLevel', 'email', 'role', 'addedBy', 'createdAt'])
        && isValidId(data.uid)
        && data.roleLevel is string && data.roleLevel in ['super_admin', 'moderator', 'finance_admin']
        && (!('email' in data) || (data.email is string && data.email.size() <= 200))
        && (!('role' in data) || (data.role is string && data.role.size() <= 60))
        && (!('addedBy' in data) || isValidId(data.addedBy))
        && data.createdAt is timestamp;
    }

    function isValidProviderProfile(data) {
      return data.keys().hasAll(['ownerId', 'businessName', 'category', 'countryCode', 'cityId', 'description', 'verificationStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'ownerId', 'businessName', 'companyName', 'category', 'countryCode', 'cityId',
          'description', 'verificationStatus', 'contactName', 'phone', 'businessPhone',
          'contactEmail', 'businessEmail', 'address', 'conventionAccepted', 'conventionVersion',
          'conventionVersionAccepted', 'conventionAcceptedAt', 'registrationSource',
          'linkedDirectoryServiceId', 'claimedDirectoryServiceId', 'adminConventionStage', 'agreedCommissionPercent',
          'agreedResponseHours', 'agreedCancellationTerms', 'blockedDates', 'seasonalRatesSummary',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 140
        && isValidCategory(data.category)
        && data.countryCode is string && data.countryCode.size() >= 2 && data.countryCode.size() <= 4
        && isValidId(data.cityId)
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 1500
        && data.verificationStatus is string && data.verificationStatus in ['pending', 'verified', 'rejected']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProviderPrivate(data) {
      return data.keys().hasAll(['ownerId', 'contactEmail', 'contactPhone', 'payoutChannel', 'registrationRef', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'contactEmail', 'contactPhone', 'payoutChannel', 'registrationRef', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.contactEmail is string && data.contactEmail.size() <= 200
        && data.contactPhone is string && data.contactPhone.size() <= 40
        && data.payoutChannel is string && data.payoutChannel.size() <= 120
        && data.registrationRef is string && data.registrationRef.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCatalogueService(data) {
      return data.keys().hasAll([
          'providerId', 'ownerId', 'title', 'category', 'countryCode', 'cityId',
          'address', 'description', 'priceAmount', 'currency', 'durationMinutes',
          'capacity', 'dataOrigin', 'status', 'imageKey', 'imageLicense', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'providerId', 'ownerId', 'title', 'category', 'countryCode', 'cityId',
          'address', 'description', 'priceAmount', 'priceKnown', 'currency', 'durationMinutes',
          'capacity', 'dataOrigin', 'verificationStatus', 'sourceName', 'verifiedAt',
          'neighborhood', 'standing', 'activationLevel', 'pilotConventionSigned', 'cancellationPolicy',
          'customPhotoUrl', 'photoVerified', 'photoSource', 'photoUsageRights',
          'isSacredOrCeremonial', 'sacredNotice', 'linkedDirectoryServiceId',
          'seasonalTariffs', 'unitTariffs', 'blockedDates', 'providerResponseHours',
          'status', 'imageKey', 'imageLicense', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.providerId)
        && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 160
        && isValidCategory(data.category)
        && data.countryCode is string && data.countryCode.size() >= 2 && data.countryCode.size() <= 4
        && isValidId(data.cityId)
        && data.address is string && data.address.size() <= 240
        && data.description is string && data.description.size() <= 2000
        && data.priceAmount is number && data.priceAmount >= 0 && data.priceAmount <= 1000000000
        && (!('priceKnown' in data) || data.priceKnown is bool)
        && isValidCurrency(data.currency)
        && data.durationMinutes is int && data.durationMinutes >= 0 && data.durationMinutes <= 43200
        && data.capacity is int && data.capacity >= 1 && data.capacity <= 1000
        && data.dataOrigin is string && data.dataOrigin in ['verified_partner', 'pending_verification', 'public_directory', 'demo_test']
        && (!('verificationStatus' in data) || (data.verificationStatus is string && data.verificationStatus in ['verified', 'partially_verified', 'to_confirm', 'unverified']))
        && (!('sourceName' in data) || (data.sourceName is string && data.sourceName.size() <= 240))
        && (!('verifiedAt' in data) || (data.verifiedAt is string && data.verifiedAt.size() <= 40))
        && (!('neighborhood' in data) || (data.neighborhood is string && data.neighborhood.size() <= 140))
        && (!('standing' in data) || (data.standing is string && data.standing in [
          'international_5', 'upper_4', 'comfort_3', 'boutique_charm', 'eco_nature', 'residence_apart', 'budget_2',
          'luxe', 'haut_de_gamme', 'intermediaire', 'economique', 'residence_meublee', 'maison_hotes', 'ecolodge'
        ]))
        && (!('activationLevel' in data) || (data.activationLevel is string && data.activationLevel in ['directory_only', 'level_a_verified', 'level_b_validation', 'level_c_instant']))
        && (!('pilotConventionSigned' in data) || data.pilotConventionSigned is bool)
        && (!('cancellationPolicy' in data) || (data.cancellationPolicy is string && data.cancellationPolicy.size() <= 500))
        && (!('customPhotoUrl' in data) || (data.customPhotoUrl is string && data.customPhotoUrl.size() <= 600))
        && (!('photoVerified' in data) || data.photoVerified is bool)
        && (!('isSacredOrCeremonial' in data) || data.isSacredOrCeremonial is bool)
        && (!('sacredNotice' in data) || (data.sacredNotice is string && data.sacredNotice.size() <= 600))
        && (!('linkedDirectoryServiceId' in data) || (data.linkedDirectoryServiceId is string && data.linkedDirectoryServiceId.size() <= 128))
        && (!('blockedDates' in data) || (data.blockedDates is list && data.blockedDates.size() <= 366))
        && (!('providerResponseHours' in data) || (data.providerResponseHours is int && data.providerResponseHours >= 1 && data.providerResponseHours <= 168))
        && data.status is string && data.status in ['draft', 'published', 'archived']
        && data.imageKey is string && data.imageKey.size() <= 100
        && data.imageLicense is string && data.imageLicense.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidJourneyFolder(data) {
      return data.keys().hasAll([
          'ownerId', 'title', 'countryCode', 'primaryCityId', 'startDate', 'endDate',
          'travelersCount', 'totalBudget', 'dailyBudget', 'currency', 'preferencesNotes',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'title', 'countryCode', 'primaryCityId', 'startDate', 'endDate',
          'travelersCount', 'totalBudget', 'dailyBudget', 'currency', 'preferencesNotes',
          'status', 'dossierFeeStatus', 'dossierFeeAmountXof', 'dossierTxRef',
          'dossierPayerName', 'dossierPayerPhone', 'dossierDeclaredAt', 'dossierVerifiedAt',
          'dossierVerifiedBy', 'dossierRejectionReason', 'dossierFeeCredited',
          'termsAcceptedVersion', 'termsAcceptedAt', 'balanceDueAt', 'balanceDueDeadlineAt',
          'balanceReminderSentAt', 'manualRefundRequired', 'manualRefundReason',
          'insuranceChecked', 'duplicatedFromFolderId', 'templateSourceFolderId', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 140
        && data.countryCode is string && data.countryCode.size() >= 2 && data.countryCode.size() <= 4
        && isValidId(data.primaryCityId)
        && data.startDate is string && data.startDate.size() <= 20
        && data.endDate is string && data.endDate.size() <= 20
        && data.travelersCount is int && data.travelersCount >= 1 && data.travelersCount <= 50
        && data.totalBudget is number && data.totalBudget >= 0 && data.totalBudget <= 1000000000
        && data.dailyBudget is number && data.dailyBudget >= 0 && data.dailyBudget <= 1000000000
        && isValidCurrency(data.currency)
        && data.preferencesNotes is string && data.preferencesNotes.size() <= 1000
        && data.status is string && data.status in [
          'draft', 'planning', 'fees_pending', 'fees_in_verification', 'fees_validated',
          'coordinating', 'requests_in_progress', 'partially_confirmed', 'to_replan',
          'needs_rescheduling', 'confirmed', 'fully_confirmed', 'awaiting_balance',
          'paid', 'active', 'completed', 'expired', 'cancelled', 'cancelled_by_client',
          'archived', 'abandoned'
        ]
        && (!('dossierFeeStatus' in data) || (data.dossierFeeStatus is string && data.dossierFeeStatus in [
          'not_required', 'not_requested', 'pending', 'declared', 'in_verification', 'validated', 'rejected', 'refund_pending', 'refunded'
        ]))
        && (!('templateSourceFolderId' in data) || (data.templateSourceFolderId is string && data.templateSourceFolderId.size() <= 128))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidJourneyItem(data) {
      return data.keys().hasAll([
          'folderId', 'ownerId', 'serviceId', 'serviceTitle', 'category', 'cityId',
          'date', 'startTime', 'endTime', 'durationMinutes', 'estimatedCost',
          'currency', 'stage', 'notes', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'folderId', 'ownerId', 'serviceId', 'providerId', 'serviceTitle', 'category', 'cityId',
          'date', 'startTime', 'endTime', 'durationMinutes', 'estimatedCost',
          'currency', 'stage', 'notes', 'isFreeTimeBlock', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.folderId)
        && isValidId(data.ownerId)
        && isValidId(data.serviceId)
        && (!('providerId' in data) || data.providerId == '' || isValidId(data.providerId))
        && data.serviceTitle is string && data.serviceTitle.size() <= 160
        && isValidCategory(data.category)
        && isValidId(data.cityId)
        && data.date is string && data.date.size() <= 20
        && data.startTime is string && data.startTime.size() <= 10
        && data.endTime is string && data.endTime.size() <= 10
        && data.durationMinutes is int && data.durationMinutes >= 0 && data.durationMinutes <= 43200
        && data.estimatedCost is number && data.estimatedCost >= 0 && data.estimatedCost <= 1000000000
        && isValidCurrency(data.currency)
        && data.stage is string && data.stage in ['envisaged', 'requested', 'accepted', 'confirmed']
        && data.notes is string && data.notes.size() <= 600
        && (!('isFreeTimeBlock' in data) || data.isFreeTimeBlock is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidJournalEntry(data) {
      return data.keys().hasAll([
          'folderId', 'ownerId', 'stepTitle', 'cityId', 'date', 'completed',
          'personalNote', 'photoUrl', 'providerContactNote', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'folderId', 'ownerId', 'linkedItemId', 'stepTitle', 'cityId', 'date', 'completed',
          'personalNote', 'photoUrl', 'providerContactNote', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.folderId)
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && (!('linkedItemId' in data) || data.linkedItemId == '' || isValidId(data.linkedItemId))
        && data.stepTitle is string && data.stepTitle.size() >= 1 && data.stepTitle.size() <= 180
        && isValidId(data.cityId)
        && data.date is string && data.date.size() <= 20
        && data.completed is bool
        && data.personalNote is string && data.personalNote.size() <= 2500
        && data.photoUrl is string && data.photoUrl.size() <= 600
        && data.providerContactNote is string && data.providerContactNote.size() <= 400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isWithinCurrencyTolerance(actual, expected, cur) {
      return cur == 'XOF'
        ? (actual >= expected - 1 && actual <= expected + 1)
        : (actual >= expected - 0.02 && actual <= expected + 0.02);
    }

    function matchesFeeBreakdown(data, commPct, flatFee, taxPct) {
      return isWithinCurrencyTolerance(
          data.amaroFee,
          (data.providerPrice * commPct) / 100.0 + flatFee,
          data.currency
        )
        && isWithinCurrencyTolerance(
          data.taxAmount,
          ((data.providerPrice + data.amaroFee) * taxPct) / 100.0,
          data.currency
        )
        && isWithinCurrencyTolerance(
          data.totalAmount,
          data.providerPrice + data.amaroFee + data.taxAmount,
          data.currency
        );
    }

    function matchesCountrySettingFees(data, countryCode) {
      return exists(/databases/$(database)/documents/system_settings/$(countryCode))
        ? (
          matchesFeeBreakdown(
            data,
            get(/databases/$(database)/documents/system_settings/$(countryCode)).data.commissionPercent,
            get(/databases/$(database)/documents/system_settings/$(countryCode)).data.serviceFeeFlat,
            get(/databases/$(database)/documents/system_settings/$(countryCode)).data.taxPercent
          )
          || (
            'partnerMarginPercent' in get(/databases/$(database)/documents/system_settings/$(countryCode)).data
            && matchesFeeBreakdown(
              data,
              get(/databases/$(database)/documents/system_settings/$(countryCode)).data.partnerMarginPercent,
              get(/databases/$(database)/documents/system_settings/$(countryCode)).data.serviceFeeFlat,
              get(/databases/$(database)/documents/system_settings/$(countryCode)).data.taxPercent
            )
          )
          || (
            'directoryMarginPercent' in get(/databases/$(database)/documents/system_settings/$(countryCode)).data
            && matchesFeeBreakdown(
              data,
              get(/databases/$(database)/documents/system_settings/$(countryCode)).data.directoryMarginPercent,
              get(/databases/$(database)/documents/system_settings/$(countryCode)).data.serviceFeeFlat,
              get(/databases/$(database)/documents/system_settings/$(countryCode)).data.taxPercent
            )
          )
          || matchesFeeBreakdown(
            data,
            5,
            get(/databases/$(database)/documents/system_settings/$(countryCode)).data.serviceFeeFlat,
            get(/databases/$(database)/documents/system_settings/$(countryCode)).data.taxPercent
          )
          || matchesFeeBreakdown(
            data,
            10,
            get(/databases/$(database)/documents/system_settings/$(countryCode)).data.serviceFeeFlat,
            get(/databases/$(database)/documents/system_settings/$(countryCode)).data.taxPercent
          )
        )
        : (
          matchesFeeBreakdown(data, 0, 0, 0)
          || matchesFeeBreakdown(data, 5, 0, 0)
          || matchesFeeBreakdown(data, 10, 0, 0)
        );
    }

    function matchesPublishedCatalogService(data, svc) {
      return svc.status == 'published'
        && !(('activationLevel' in svc) && svc.activationLevel == 'level_a_verified')
        && data.providerId == svc.providerId
        && data.providerOwnerId == svc.ownerId
        && data.category == svc.category
        && data.cityId == svc.cityId
        && data.currency == svc.currency
        && data.participants >= 1
        && data.participants <= svc.capacity
        && (
          isWithinCurrencyTolerance(data.providerPrice, svc.priceAmount * data.participants, data.currency)
          || (
            'allocatedStockId' in data
            && isValidId(data.allocatedStockId)
            && exists(/databases/$(database)/documents/pilot_stocks/$(data.allocatedStockId))
            && isWithinCurrencyTolerance(
              data.providerPrice,
              get(/databases/$(database)/documents/pilot_stocks/$(data.allocatedStockId)).data.contractualPrice * data.participants,
              data.currency
            )
          )
        )
        && matchesCountrySettingFees(data, svc.countryCode);
    }

    function matchesOfficialDemoService(data) {
      return data.providerId == 'demo-provider-bj'
        && data.providerOwnerId == 'manual_concierge'
        && data.currency == 'XOF'
        && matchesCountrySettingFees(data, 'BJ')
        && (
          (data.serviceId == 'demo-cotonou-lodging-1' && data.category == 'accommodation' && data.cityId == 'cotonou' && data.participants <= 2 && data.providerPrice == 45000 * data.participants)
          || (data.serviceId == 'demo-calavi-site-1' && data.category == 'site' && data.cityId == 'abomey-calavi' && data.participants <= 6 && data.providerPrice == 18000 * data.participants)
          || (data.serviceId == 'demo-cotonou-dining-1' && data.category == 'restaurant' && data.cityId == 'cotonou' && data.participants <= 4 && data.providerPrice == 15000 * data.participants)
          || (data.serviceId == 'demo-parakou-craft-1' && data.category == 'shopping' && data.cityId == 'parakou' && data.participants <= 8 && data.providerPrice == 12000 * data.participants)
          || (data.serviceId == 'demo-cotonou-transport-1' && data.category == 'transport' && data.cityId == 'cotonou' && data.participants <= 4 && data.providerPrice == 35000 * data.participants)
          || (data.serviceId == 'demo-calavi-translation-1' && data.category == 'translation' && data.cityId == 'abomey-calavi' && data.participants <= 5 && data.providerPrice == 20000 * data.participants)
          || (data.serviceId == 'demo-cotonou-wellness-1' && data.category == 'wellness' && data.cityId == 'cotonou' && data.participants <= 2 && data.providerPrice == 22000 * data.participants)
        );
    }

    function matchesOfficialPublicDirectoryService(data) {
      return data.providerOwnerId == 'manual_concierge'
        && data.providerId.matches('^dir-[a-zA-Z0-9_\\-]+$')
        && data.serviceId.matches('^(acc|site|trans|trad|well|shop|rest)-[a-zA-Z0-9_\\-]+$')
        && data.currency == 'XOF'
        && data.pricingSnapshot.matches('.*"verifiedByServer":true.*')
        && matchesCountrySettingFees(data, 'BJ');
    }

    function hasAuthoritativeReservationPricing(data) {
      return exists(/databases/$(database)/documents/services/$(data.serviceId))
        ? matchesPublishedCatalogService(
            data,
            get(/databases/$(database)/documents/services/$(data.serviceId)).data
          )
        : (matchesOfficialDemoService(data) || matchesOfficialPublicDirectoryService(data));
    }

    function isValidReservation(data) {
      return data.keys().hasAll([
          'clientId', 'providerOwnerId', 'providerId', 'folderId', 'serviceId',
          'serviceTitle', 'category', 'cityId', 'scheduledDate', 'scheduledTime',
          'participants', 'providerPrice', 'amaroFee', 'taxAmount', 'totalAmount',
          'currency', 'status', 'paymentStatus', 'alternativeProposal', 'pricingSnapshot',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'clientId', 'providerOwnerId', 'providerId', 'folderId', 'serviceId',
          'serviceTitle', 'category', 'cityId', 'scheduledDate', 'scheduledTime',
          'participants', 'providerPrice', 'amaroFee', 'taxAmount', 'totalAmount',
          'currency', 'status', 'paymentStatus', 'alternativeProposal', 'pricingSnapshot',
          'referralCode', 'providerSettled',
          'activationMode', 'allocatedStockId', 'allocatedUnits',
          'dispatchChannel', 'dispatchStatus', 'responseDeadlineAt', 'followUpCount',
          'circuitType', 'coordinationStatus', 'coordinationContactedAt', 'coordinationOutcome',
          'halfTimeReminderSentAt', 'balanceDeadlineAt', 'adminNotifyProviderTask', 'localContributionXof',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.clientId)
        && isValidId(data.providerOwnerId)
        && isValidId(data.providerId)
        && isValidId(data.folderId)
        && isValidId(data.serviceId)
        && data.serviceTitle is string && data.serviceTitle.size() >= 2 && data.serviceTitle.size() <= 160
        && isValidCategory(data.category)
        && isValidId(data.cityId)
        && data.scheduledDate is string && data.scheduledDate.size() >= 8 && data.scheduledDate.size() <= 20
        && data.scheduledTime is string && data.scheduledTime.size() >= 4 && data.scheduledTime.size() <= 10
        && data.participants is int && data.participants >= 1 && data.participants <= 100
        && data.providerPrice is number && data.providerPrice >= 0 && data.providerPrice <= 1000000000
        && data.amaroFee is number && data.amaroFee >= 0 && data.amaroFee <= 1000000000
        && data.taxAmount is number && data.taxAmount >= 0 && data.taxAmount <= 1000000000
        && data.totalAmount is number && data.totalAmount >= 0 && data.totalAmount <= 1000000000
        && isValidCurrency(data.currency)
        && data.status is string && data.status in [
          'pending_provider', 'accepted', 'rejected', 'alternative_proposed',
          'awaiting_payment', 'confirmed', 'cancelled', 'refunded'
        ]
        && data.paymentStatus is string && data.paymentStatus in [
          'unpaid', 'initiated', 'pending', 'succeeded', 'failed', 'refunded'
        ]
        && data.alternativeProposal is string && data.alternativeProposal.size() <= 800
        && data.pricingSnapshot is string && data.pricingSnapshot.size() >= 2 && data.pricingSnapshot.size() <= 600
        && (!('referralCode' in data) || (data.referralCode is string && data.referralCode.size() <= 40))
        && (!('providerSettled' in data) || data.providerSettled is bool)
        && (!('activationMode' in data) || (data.activationMode is string && data.activationMode in ['directory_concierge', 'level_b_validation', 'level_c_instant']))
        && (!('allocatedStockId' in data) || data.allocatedStockId == '' || isValidId(data.allocatedStockId))
        && (!('allocatedUnits' in data) || (data.allocatedUnits is int && data.allocatedUnits >= 0 && data.allocatedUnits <= 100))
        && (!('dispatchChannel' in data) || (data.dispatchChannel is string && data.dispatchChannel in ['amaro_portal', 'configured_email', 'manual_concierge']))
        && (!('dispatchStatus' in data) || (data.dispatchStatus is string && data.dispatchStatus in ['prepared', 'sent', 'send_failed', 'response_received', 'accepted', 'rejected', 'expired']))
        && (!('responseDeadlineAt' in data) || (data.responseDeadlineAt is string && data.responseDeadlineAt.size() <= 40))
        && (!('followUpCount' in data) || (data.followUpCount is int && data.followUpCount >= 0 && data.followUpCount <= 50))
        && (!('circuitType' in data) || (data.circuitType is string && data.circuitType in ['circuit_a_directory', 'circuit_b_partner']))
        && (!('coordinationStatus' in data) || (data.coordinationStatus is string && data.coordinationStatus in ['to_contact', 'contacted', 'confirmed', 'unavailable', 'quote_received']))
        && (!('localContributionXof' in data) || (data.localContributionXof is number && data.localContributionXof >= 0))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPartnerProfile(data) {
      return data.keys().hasAll([
          'ownerId', 'displayName', 'channelUrl', 'referralCode', 'status',
          'customCommissionRate', 'visitsCount', 'signupsCount', 'reservationsCount',
          'confirmedCount', 'paidAmountXof', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'displayName', 'channelUrl', 'referralCode', 'status',
          'customCommissionRate', 'visitsCount', 'signupsCount', 'reservationsCount',
          'confirmedCount', 'paidAmountXof', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 120
        && data.channelUrl is string && data.channelUrl.size() <= 300
        && data.referralCode is string && data.referralCode.size() >= 3 && data.referralCode.size() <= 40 && data.referralCode.matches('^[A-Z0-9_\\-]+$')
        && data.status is string && data.status in ['pending', 'active', 'suspended']
        && data.customCommissionRate is number && data.customCommissionRate >= 0 && data.customCommissionRate <= 100
        && data.visitsCount is int && data.visitsCount >= 0
        && data.signupsCount is int && data.signupsCount >= 0
        && data.reservationsCount is int && data.reservationsCount >= 0
        && data.confirmedCount is int && data.confirmedCount >= 0
        && data.paidAmountXof is number && data.paidAmountXof >= 0
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPartnerReferral(data) {
      return data.keys().hasAll([
          'partnerId', 'partnerOwnerId', 'referralCode', 'reservationId', 'clientId',
          'serviceTitle', 'reservationAmount', 'commissionRatePercent', 'commissionAmount',
          'currency', 'status', 'clientPaid', 'providerSettled', 'attributionModel',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'partnerId', 'partnerOwnerId', 'referralCode', 'reservationId', 'clientId',
          'serviceTitle', 'reservationAmount', 'commissionRatePercent', 'commissionAmount',
          'currency', 'status', 'clientPaid', 'providerSettled', 'attributionModel',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.partnerId)
        && isValidId(data.partnerOwnerId)
        && data.referralCode is string && data.referralCode.size() >= 3 && data.referralCode.size() <= 40
        && isValidId(data.reservationId)
        && isValidId(data.clientId)
        && data.serviceTitle is string && data.serviceTitle.size() >= 2 && data.serviceTitle.size() <= 160
        && data.reservationAmount is number && data.reservationAmount >= 0 && data.reservationAmount <= 1000000000
        && data.commissionRatePercent is number && data.commissionRatePercent >= 0 && data.commissionRatePercent <= 100
        && data.commissionAmount is number && data.commissionAmount >= 0 && data.commissionAmount <= 1000000000
        && isValidCurrency(data.currency)
        && data.status is string && data.status in [
          'pending', 'reservation_confirmed', 'awaiting_client_payment',
          'awaiting_provider_settlement', 'validated', 'payable', 'paid', 'cancelled_or_rejected'
        ]
        && data.clientPaid is bool
        && data.providerSettled is bool
        && data.attributionModel is string && data.attributionModel in ['first_touch', 'last_touch']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll(['recipientId', 'senderId', 'kind', 'title', 'body', 'read', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['recipientId', 'senderId', 'kind', 'title', 'body', 'read', 'createdAt', 'updatedAt'])
        && isValidId(data.recipientId)
        && isValidId(data.senderId)
        && data.kind is string && data.kind in ['reservation', 'payment', 'alternative', 'system']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 800
        && data.read is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCulturalStory(data) {
      return data.keys().hasAll(['authorId', 'authorName', 'countryCode', 'cityId', 'title', 'story', 'moderationStatus', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['authorId', 'authorName', 'countryCode', 'cityId', 'title', 'story', 'moderationStatus', 'createdAt', 'updatedAt'])
        && isValidId(data.authorId)
        && data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 100
        && data.countryCode is string && data.countryCode.size() >= 2 && data.countryCode.size() <= 4
        && isValidId(data.cityId)
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 160
        && data.story is string && data.story.size() >= 10 && data.story.size() <= 2500
        && data.moderationStatus is string && data.moderationStatus in ['pending', 'approved', 'rejected']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSystemSetting(data) {
      return data.keys().hasAll(['countryCode', 'commissionPercent', 'serviceFeeFlat', 'taxPercent', 'currency', 'updatedBy', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'countryCode', 'commissionPercent', 'serviceFeeFlat', 'taxPercent', 'currency',
          'partnerCommissionPercent', 'attributionWindowDays', 'attributionModel',
          'partnerMarginPercent', 'directoryMarginPercent', 'dossierFeeXof', 'dossierFeeAmount',
          'dossierVerificationHours', 'providerResponseHours', 'balancePaymentHours',
          'maxPendingPaymentFolders', 'abandonmentRiskThreshold', 'alternativeBudgetTolerancePercent',
          'maxVisitsCityChangeDay', 'maxVisitsSameCityDay', 'freeTimeBlocksPerDay',
          'includeDossierFeeInAffiliateBase', 'localContributionPercent', 'localContributionLabel',
          'amaroMobileMoneyNumber', 'amaroMobileMoneyHolder', 'amaroWhatsappNumber', 'supportWhatsappNumber',
          'vaultKeyConfirmedByOwner', 'financialRetentionDuration', 'termsVersion', 'conventionVersion',
          'includeDemoData', 'exchangeRateEurToXof', 'exchangeRateUsdToXof',
          'exchangeRateSource', 'exchangeRateUpdatedAt',
          'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.countryCode is string && data.countryCode.size() >= 2 && data.countryCode.size() <= 4
        && data.commissionPercent is number && data.commissionPercent >= 0 && data.commissionPercent <= 100
        && data.serviceFeeFlat is number && data.serviceFeeFlat >= 0 && data.serviceFeeFlat <= 10000000
        && data.taxPercent is number && data.taxPercent >= 0 && data.taxPercent <= 100
        && isValidCurrency(data.currency)
        && isValidId(data.updatedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['actorId', 'action', 'targetId', 'summary', 'createdAt'])
        && data.keys().hasOnly(['actorId', 'action', 'targetType', 'targetId', 'summary', 'createdAt'])
        && isValidId(data.actorId)
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 120
        && (!('targetType' in data) || (data.targetType is string && data.targetType.size() <= 60))
        && isValidId(data.targetId)
        && data.summary is string && data.summary.size() <= 600
        && data.createdAt is timestamp;
    }

    function isValidIdentityVerification(data) {
      return data.keys().hasAll([
          'reservationId', 'folderId', 'clientId', 'providerOwnerId', 'providerId',
          'serviceTitle', 'category', 'documentType', 'otherDocumentLabel',
          'nationalityCountry', 'residenceCountry', 'hasBackSide', 'status',
          'purposeReason', 'recipientLabel', 'consentGiven', 'consentAt',
          'providerAuthorized', 'retentionExpiresAt', 'statusNote',
          'accessCount', 'lastAccessedBy', 'lastAccessedAt', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'reservationId', 'folderId', 'clientId', 'providerOwnerId', 'providerId',
          'serviceTitle', 'category', 'documentType', 'otherDocumentLabel',
          'nationalityCountry', 'residenceCountry', 'hasBackSide', 'status',
          'purposeReason', 'recipientLabel', 'consentGiven', 'consentAt',
          'providerAuthorized', 'retentionExpiresAt', 'statusNote',
          'accessCount', 'lastAccessedBy', 'lastAccessedAt', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.reservationId)
        && isValidId(data.folderId)
        && isValidId(data.clientId)
        && isValidId(data.providerOwnerId)
        && isValidId(data.providerId)
        && data.serviceTitle is string && data.serviceTitle.size() >= 1 && data.serviceTitle.size() <= 160
        && isValidCategory(data.category)
        && data.documentType is string && data.documentType in ['none', 'national_id', 'passport', 'residence_permit', 'other_official']
        && data.otherDocumentLabel is string && data.otherDocumentLabel.size() <= 120
        && data.nationalityCountry is string && data.nationalityCountry.size() <= 60
        && data.residenceCountry is string && data.residenceCountry.size() <= 60
        && data.hasBackSide is bool
        && data.status is string && data.status in [
          'not_requested', 'requested', 'submitted_by_client', 'pending_verification',
          'shared_with_provider', 'accepted', 'rejected', 'renewal_required', 'deleted_retention_policy'
        ]
        && data.purposeReason is string && data.purposeReason.size() <= 400
        && data.recipientLabel is string && data.recipientLabel.size() <= 180
        && data.consentGiven is bool
        && data.consentAt is string && data.consentAt.size() <= 40
        && data.providerAuthorized is bool
        && (!(data.providerAuthorized == true) || (data.consentGiven == true && data.providerOwnerId != 'manual_concierge'))
        && data.retentionExpiresAt is string && data.retentionExpiresAt.size() <= 40
        && data.statusNote is string && data.statusNote.size() <= 400
        && data.accessCount is int && data.accessCount >= 0
        && data.lastAccessedBy is string && data.lastAccessedBy.size() <= 128
        && data.lastAccessedAt is string && data.lastAccessedAt.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidIdentityVault(data) {
      return data.keys().hasAll([
          'reservationId', 'clientId', 'providerOwnerId',
          'frontMimeType', 'frontCipherPayload',
          'backMimeType', 'backCipherPayload',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'reservationId', 'clientId', 'providerOwnerId',
          'frontMimeType', 'frontCipherPayload',
          'backMimeType', 'backCipherPayload',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.reservationId)
        && isValidId(data.clientId)
        && isValidId(data.providerOwnerId)
        && data.frontMimeType is string && data.frontMimeType in ['image/jpeg', 'image/png', 'image/webp']
        && data.frontCipherPayload is string && data.frontCipherPayload.size() >= 16 && data.frontCipherPayload.size() <= 750000
        && data.backMimeType is string && (data.backMimeType == '' || data.backMimeType in ['image/jpeg', 'image/png', 'image/webp'])
        && data.backCipherPayload is string && data.backCipherPayload.size() <= 750000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidIdentityAccessLog(data) {
      return data.keys().hasAll(['reservationId', 'actorId', 'actorRole', 'action', 'summary', 'createdAt'])
        && data.keys().hasOnly(['reservationId', 'actorId', 'actorRole', 'action', 'summary', 'createdAt'])
        && isValidId(data.reservationId)
        && isValidId(data.actorId)
        && data.actorRole is string && data.actorRole in ['traveler', 'provider', 'admin']
        && data.action is string && data.action.size() >= 2 && data.action.size() <= 80
        && data.summary is string && data.summary.size() <= 500
        && data.createdAt is timestamp;
    }

    function isValidPilotPartner(data) {
      return data.keys().hasAll([
          'businessName', 'category', 'cityId', 'coveredZones', 'businessAddress',
          'businessPhone', 'businessEmail', 'officialWebsite', 'contactNameAndRole',
          'infoSource', 'verifiedDate', 'conventionStatus', 'contactStatus',
          'negotiationStatus', 'documentsReceived', 'conventionSigned',
          'conventionSignedRef', 'registeredServiceId', 'tariffsConfirmed',
          'availabilitiesConfirmed', 'allowedBookingMode', 'dispatchChannel',
          'nextAction', 'internalNotes', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'businessName', 'category', 'cityId', 'coveredZones', 'businessAddress',
          'businessPhone', 'businessEmail', 'officialWebsite', 'contactNameAndRole',
          'infoSource', 'verifiedDate', 'conventionStatus', 'contactStatus',
          'negotiationStatus', 'documentsReceived', 'conventionSigned',
          'conventionSignedRef', 'registeredServiceId', 'tariffsConfirmed',
          'availabilitiesConfirmed', 'allowedBookingMode', 'dispatchChannel',
          'nextAction', 'internalNotes', 'updatedBy', 'createdAt', 'updatedAt'
        ])
        && data.businessName is string && data.businessName.size() >= 2 && data.businessName.size() <= 160
        && data.category is string && data.category in ['accommodation', 'transport']
        && data.cityId is string && data.cityId in ['cotonou', 'ouidah', 'abomey', 'grand-popo', 'natitingou']
        && data.coveredZones is string && data.coveredZones.size() <= 240
        && data.businessAddress is string && data.businessAddress.size() <= 240
        && data.businessPhone is string && data.businessPhone.size() <= 60
        && data.businessEmail is string && data.businessEmail.size() <= 200
        && data.officialWebsite is string && data.officialWebsite.size() <= 300
        && data.contactNameAndRole is string && data.contactNameAndRole.size() <= 180
        && data.infoSource is string && data.infoSource.size() <= 240
        && data.verifiedDate is string && data.verifiedDate.size() <= 30
        && data.conventionStatus is string && data.conventionStatus in [
          'to_identify', 'identified', 'contacts_to_verify', 'to_contact',
          'contacted', 'response_received', 'negotiation_in_progress', 'awaiting_documents',
          'commercial_terms_agreed', 'convention_pending_signature', 'convention_signed',
          'catalogue_to_complete', 'offers_under_verification', 'pilot_activated',
          'suspended', 'convention_terminated'
        ]
        && data.contactStatus is string && data.contactStatus.size() <= 120
        && data.negotiationStatus is string && data.negotiationStatus.size() <= 200
        && data.documentsReceived is string && data.documentsReceived.size() <= 500
        && data.conventionSigned is bool
        && data.conventionSignedRef is string && data.conventionSignedRef.size() <= 160
        && (!(data.conventionStatus in ['convention_signed', 'pilot_activated']) || (data.conventionSigned == true && data.conventionSignedRef.size() >= 3))
        && data.registeredServiceId is string && data.registeredServiceId.size() <= 128
        && data.tariffsConfirmed is bool
        && data.availabilitiesConfirmed is bool
        && data.allowedBookingMode is string && data.allowedBookingMode in ['none', 'level_a_verified', 'level_b_validation', 'level_c_instant']
        && (!(data.allowedBookingMode == 'level_c_instant') || (data.conventionSigned == true && data.tariffsConfirmed == true && data.availabilitiesConfirmed == true && data.conventionStatus == 'pilot_activated'))
        && data.dispatchChannel is string && data.dispatchChannel in ['amaro_portal', 'configured_email', 'manual_concierge']
        && data.nextAction is string && data.nextAction.size() <= 300
        && data.internalNotes is string && data.internalNotes.size() <= 2000
        && isValidId(data.updatedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPilotStock(data) {
      return data.keys().hasAll([
          'pilotId', 'serviceId', 'providerId', 'providerOwnerId', 'category',
          'cityId', 'unitCode', 'unitLabel', 'capacity', 'baggageCapacity',
          'withDriver', 'pickupAndCoverageZone', 'startDate', 'endDate',
          'totalUnits', 'bookedUnits', 'contractualPrice', 'currency',
          'cancellationRules', 'instantBookingAgreed', 'settlementMode',
          'confirmationSource', 'expiresAt', 'status', 'updatedBy',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'pilotId', 'serviceId', 'providerId', 'providerOwnerId', 'category',
          'cityId', 'unitCode', 'unitLabel', 'capacity', 'baggageCapacity',
          'withDriver', 'pickupAndCoverageZone', 'startDate', 'endDate',
          'totalUnits', 'bookedUnits', 'contractualPrice', 'currency',
          'cancellationRules', 'instantBookingAgreed', 'settlementMode',
          'confirmationSource', 'expiresAt', 'status', 'lastReservationId',
          'updatedBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.pilotId)
        && isValidId(data.serviceId)
        && isValidId(data.providerId)
        && isValidId(data.providerOwnerId)
        && data.category is string && data.category in ['accommodation', 'transport']
        && data.cityId is string && data.cityId in ['cotonou', 'ouidah', 'abomey', 'grand-popo', 'natitingou']
        && data.unitCode is string && data.unitCode.size() >= 1 && data.unitCode.size() <= 80
        && data.unitLabel is string && data.unitLabel.size() >= 2 && data.unitLabel.size() <= 160
        && data.capacity is int && data.capacity >= 1 && data.capacity <= 100
        && data.baggageCapacity is int && data.baggageCapacity >= 0 && data.baggageCapacity <= 50
        && data.withDriver is bool
        && data.pickupAndCoverageZone is string && data.pickupAndCoverageZone.size() <= 240
        && data.startDate is string && data.startDate.size() >= 8 && data.startDate.size() <= 20
        && data.endDate is string && data.endDate.size() >= 8 && data.endDate.size() <= 20
        && data.totalUnits is int && data.totalUnits >= 1 && data.totalUnits <= 500
        && data.bookedUnits is int && data.bookedUnits >= 0 && data.bookedUnits <= data.totalUnits
        && data.contractualPrice is number && data.contractualPrice > 0 && data.contractualPrice <= 1000000000
        && isValidCurrency(data.currency)
        && data.cancellationRules is string && data.cancellationRules.size() >= 5 && data.cancellationRules.size() <= 500
        && data.instantBookingAgreed is bool
        && data.settlementMode is string && data.settlementMode in ['pay_on_arrival_agreed', 'online_gateway_required']
        && data.confirmationSource is string && data.confirmationSource.size() >= 3 && data.confirmationSource.size() <= 240
        && data.expiresAt is string && data.expiresAt.size() >= 10 && data.expiresAt.size() <= 30
        && data.status is string && data.status in ['active', 'paused', 'expired']
        && (!('lastReservationId' in data) || data.lastReservationId == '' || isValidId(data.lastReservationId))
        && isValidId(data.updatedBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Connectivity Probe ---
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }

    // --- 1. Users & Isolated PII / Consented Preferences ---
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isBootstrappedAdmin();

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && request.auth.uid == userId
        && isValidUserPublic(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserPublic(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'accountType', 'preferredLocale', 'preferredCurrency', 'updatedAt']))
          || isAdmin()
        );

      allow delete: if isValidId(userId) && ((isVerifiedUser() && request.auth.uid == userId) || isAdmin());

      match /private/{docId} {
        allow get: if isSignedIn()
          && isValidId(userId)
          && docId in ['info', 'preferences']
          && (request.auth.uid == userId || isAdmin());
        allow list: if false;

        allow create: if isVerifiedUser()
          && isValidId(userId)
          && request.auth.uid == userId
          && (
            (docId == 'info'
              && isValidUserPrivate(incoming())
              && incoming().createdAt == request.time
              && incoming().updatedAt == request.time
              && exists(/databases/$(database)/documents/users/$(userId)))
            || (docId == 'preferences' && isValidUserPreferences(incoming()))
          );

        allow update: if isVerifiedUser()
          && isValidId(userId)
          && (
            (docId == 'info'
              && isValidUserPrivate(incoming())
              && incoming().uid == existing().uid
              && incoming().createdAt == existing().createdAt
              && incoming().updatedAt == request.time
              && (
                (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'phone', 'phoneVerified', 'emergencyContact', 'updatedAt']))
                || isAdmin()
              ))
            || (docId == 'preferences' && request.auth.uid == userId && isValidUserPreferences(incoming()))
          );

        allow delete: if isValidId(userId)
          && docId in ['info', 'preferences']
          && ((isVerifiedUser() && request.auth.uid == userId) || isAdmin());
      }
    }

    // --- 2. Admins Registry ---
    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if isBootstrappedAdmin();

      allow create: if isAdmin()
        && isValidId(adminUid)
        && isValidAdminRecord(incoming())
        && incoming().uid == adminUid
        && incoming().createdAt == request.time;

      allow update: if false;
      allow delete: if isAdmin() && isValidId(adminUid);
    }

    // --- 3. Providers & Commercial Private Subcollection ---
    match /providers/{providerId} {
      allow get: if isValidId(providerId) && (existing().verificationStatus == 'verified' || (isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin())));
      allow list: if existing().verificationStatus == 'verified' || (isSignedIn() && existing().ownerId == request.auth.uid) || isBootstrappedAdmin();

      allow create: if isVerifiedUser()
        && isValidId(providerId)
        && isValidProviderProfile(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().verificationStatus == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(providerId)
        && isValidProviderProfile(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (existing().ownerId == request.auth.uid
            && incoming().verificationStatus == existing().verificationStatus
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'businessName', 'companyName', 'category', 'countryCode', 'cityId',
              'description', 'contactName', 'phone', 'businessPhone', 'contactEmail',
              'businessEmail', 'address', 'claimedDirectoryServiceId', 'blockedDates', 'seasonalRatesSummary', 'updatedAt'
            ]))
          || isAdmin()
        );

      allow delete: if isAdmin() && isValidId(providerId);

      match /private/{docId} {
        allow get: if isSignedIn()
          && isValidId(providerId)
          && docId == 'commercial'
          && (
            get(/databases/$(database)/documents/providers/$(providerId)).data.ownerId == request.auth.uid
            || isAdmin()
          );
        allow list: if false;

        allow create: if isVerifiedUser()
          && isValidId(providerId)
          && docId == 'commercial'
          && isValidProviderPrivate(incoming())
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/providers/$(providerId)).data.ownerId == request.auth.uid;

        allow update: if isVerifiedUser()
          && isValidId(providerId)
          && docId == 'commercial'
          && isValidProviderPrivate(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (get(/databases/$(database)/documents/providers/$(providerId)).data.ownerId == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['contactEmail', 'contactPhone', 'payoutChannel', 'registrationRef', 'updatedAt']))
            || isAdmin()
          );

        allow delete: if isAdmin() && isValidId(providerId) && docId == 'commercial';
      }
    }

    // --- 4. Tourism Services Catalogue ---
    match /services/{serviceId} {
      allow get: if isValidId(serviceId) && (existing().status == 'published' || (isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin())));
      allow list: if existing().status == 'published' || (isSignedIn() && existing().ownerId == request.auth.uid) || isBootstrappedAdmin();

      allow create: if isVerifiedUser()
        && isValidId(serviceId)
        && isValidCatalogueService(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && (incoming().ownerId == request.auth.uid || incoming().ownerId == 'manual_concierge'))
          || (
            incoming().ownerId == request.auth.uid
            && incoming().dataOrigin == 'pending_verification'
            && !('isSacredOrCeremonial' in incoming() && incoming().isSacredOrCeremonial == true)
            && get(/databases/$(database)/documents/providers/$(incoming().providerId)).data.ownerId == request.auth.uid
          )
        );

      allow update: if isVerifiedUser()
        && isValidId(serviceId)
        && isValidCatalogueService(incoming())
        && (incoming().ownerId == existing().ownerId || isAdmin())
        && (incoming().providerId == existing().providerId || isAdmin())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (existing().ownerId == request.auth.uid
            && incoming().dataOrigin == existing().dataOrigin
            && !('isSacredOrCeremonial' in incoming() && incoming().isSacredOrCeremonial == true && !('isSacredOrCeremonial' in existing() && existing().isSacredOrCeremonial == true))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'category', 'address', 'description', 'priceAmount', 'priceKnown',
              'currency', 'durationMinutes', 'capacity', 'neighborhood', 'standing',
              'cancellationPolicy', 'blockedDates', 'seasonalTariffs', 'unitTariffs',
              'providerResponseHours', 'verificationStatus', 'status', 'imageKey', 'imageLicense', 'updatedAt'
            ]))
          || isAdmin()
        );

      allow delete: if isAdmin() && isValidId(serviceId);
    }

    // --- 5. Amaro Journey Folders, Master-Gated Items, Intentions, Expenses & Logbook ---
    match /journey_folders/{folderId} {
      allow get: if isSignedIn() && isValidId(folderId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());

      allow create: if isVerifiedUser()
        && isValidId(folderId)
        && isValidJourneyFolder(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(folderId)
        && isValidJourneyFolder(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (existing().ownerId == request.auth.uid
            && (existing().status != 'archived' || isAdmin())
            && !('dossierVerifiedBy' in incoming().diff(existing()).affectedKeys())
            && (!(incoming().dossierFeeStatus in ['validated', 'refunded']) || existing().dossierFeeStatus == incoming().dossierFeeStatus)
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'countryCode', 'primaryCityId', 'startDate', 'endDate',
              'travelersCount', 'totalBudget', 'dailyBudget', 'currency',
              'preferencesNotes', 'status', 'dossierFeeStatus', 'dossierFeeAmountXof',
              'dossierTxRef', 'dossierPayerName', 'dossierPayerPhone', 'dossierDeclaredAt',
              'termsAcceptedVersion', 'termsAcceptedAt', 'insuranceChecked', 'updatedAt'
            ]))
          || isAdmin()
        );

      allow delete: if isVerifiedUser() && isValidId(folderId) && (existing().ownerId == request.auth.uid || isAdmin());

      match /items/{itemId} {
        allow get: if isSignedIn()
          && isValidId(folderId)
          && isValidId(itemId)
          && (
            get(/databases/$(database)/documents/journey_folders/$(folderId)).data.ownerId == request.auth.uid
            || isAdmin()
          );
        allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());

        allow create: if isVerifiedUser()
          && isValidId(folderId)
          && isValidId(itemId)
          && isValidJourneyItem(incoming())
          && incoming().folderId == folderId
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/journey_folders/$(folderId)).data.ownerId == request.auth.uid;

        allow update: if isVerifiedUser()
          && isValidId(folderId)
          && isValidId(itemId)
          && isValidJourneyItem(incoming())
          && incoming().folderId == existing().folderId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            (get(/databases/$(database)/documents/journey_folders/$(folderId)).data.ownerId == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly([
                'serviceTitle', 'providerId', 'category', 'cityId', 'date', 'startTime', 'endTime',
                'durationMinutes', 'estimatedCost', 'stage', 'notes', 'isFreeTimeBlock', 'updatedAt'
              ]))
            || isAdmin()
          );

        allow delete: if isVerifiedUser()
          && isValidId(folderId)
          && isValidId(itemId)
          && (
            get(/databases/$(database)/documents/journey_folders/$(folderId)).data.ownerId == request.auth.uid
            || isAdmin()
          );
      }

      // Strictly private trip intention & post-trip reflection (NEVER readable by providers)
      match /private/{docId} {
        allow get: if isSignedIn()
          && isValidId(folderId)
          && docId == 'intention'
          && get(/databases/$(database)/documents/journey_folders/$(folderId)).data.ownerId == request.auth.uid;
        allow list: if false;

        allow create, update: if isVerifiedUser()
          && isValidId(folderId)
          && docId == 'intention'
          && incoming().folderId == folderId
          && incoming().ownerId == request.auth.uid
          && get(/databases/$(database)/documents/journey_folders/$(folderId)).data.ownerId == request.auth.uid;

        allow delete: if isVerifiedUser()
          && isValidId(folderId)
          && docId == 'intention'
          && (get(/databases/$(database)/documents/journey_folders/$(folderId)).data.ownerId == request.auth.uid || isAdmin());
      }

      match /expenses/{expenseId} {
        allow get: if isSignedIn()
          && isValidId(folderId)
          && isValidId(expenseId)
          && get(/databases/$(database)/documents/journey_folders/$(folderId)).data.ownerId == request.auth.uid;
        allow list: if isSignedIn() && existing().ownerId == request.auth.uid;

        allow create, update: if isVerifiedUser()
          && isValidId(folderId)
          && isValidId(expenseId)
          && incoming().folderId == folderId
          && incoming().ownerId == request.auth.uid
          && isValidCategory(incoming().category)
          && incoming().label is string && incoming().label.size() >= 1 && incoming().label.size() <= 160
          && incoming().amount is number && incoming().amount >= 0 && incoming().amount <= 1000000000
          && isValidCurrency(incoming().currency)
          && get(/databases/$(database)/documents/journey_folders/$(folderId)).data.ownerId == request.auth.uid;

        allow delete: if isVerifiedUser()
          && isValidId(folderId)
          && isValidId(expenseId)
          && (get(/databases/$(database)/documents/journey_folders/$(folderId)).data.ownerId == request.auth.uid || isAdmin());
      }

      match /change_history/{historyId} {
        allow get: if isSignedIn()
          && isValidId(folderId)
          && isValidId(historyId)
          && (get(/databases/$(database)/documents/journey_folders/$(folderId)).data.ownerId == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());

        allow create: if isVerifiedUser()
          && isValidId(folderId)
          && isValidId(historyId)
          && (get(/databases/$(database)/documents/journey_folders/$(folderId)).data.ownerId == request.auth.uid || isAdmin());
        allow update, delete: if false;
      }

      match /journal/{entryId} {
        allow get: if isSignedIn()
          && isValidId(folderId)
          && isValidId(entryId)
          && (
            get(/databases/$(database)/documents/journey_folders/$(folderId)).data.ownerId == request.auth.uid
            || isAdmin()
          );
        allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());

        allow create: if isVerifiedUser()
          && isValidId(folderId)
          && isValidId(entryId)
          && isValidJournalEntry(incoming())
          && incoming().folderId == folderId
          && incoming().ownerId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/journey_folders/$(folderId)).data.ownerId == request.auth.uid;

        allow update: if isVerifiedUser()
          && isValidId(folderId)
          && isValidId(entryId)
          && isValidJournalEntry(incoming())
          && incoming().folderId == existing().folderId
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && get(/databases/$(database)/documents/journey_folders/$(folderId)).data.ownerId == request.auth.uid
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'stepTitle', 'cityId', 'date', 'completed', 'personalNote',
              'photoUrl', 'providerContactNote', 'updatedAt'
            ])
            || isAdmin()
          );

        allow delete: if isVerifiedUser()
          && isValidId(folderId)
          && isValidId(entryId)
          && (
            get(/databases/$(database)/documents/journey_folders/$(folderId)).data.ownerId == request.auth.uid
            || isAdmin()
          );
      }
    }

    // --- 6. Centralized Reservations State Machine ---
    match /reservations/{reservationId} {
      allow get: if isSignedIn()
        && isValidId(reservationId)
        && (existing().clientId == request.auth.uid || existing().providerOwnerId == request.auth.uid || isAdmin());

      allow list: if isSignedIn()
        && (existing().clientId == request.auth.uid || existing().providerOwnerId == request.auth.uid || isBootstrappedAdmin());

      allow create: if isVerifiedUser()
        && isValidId(reservationId)
        && isValidReservation(incoming())
        && incoming().clientId == request.auth.uid
        && (
          incoming().status == 'pending_provider'
          || (
            'activationMode' in incoming()
            && incoming().activationMode == 'level_c_instant'
            && incoming().status == 'confirmed'
            && 'allocatedStockId' in incoming()
            && isValidId(incoming().allocatedStockId)
            && exists(/databases/$(database)/documents/pilot_stocks/$(incoming().allocatedStockId))
            && get(/databases/$(database)/documents/pilot_stocks/$(incoming().allocatedStockId)).data.status == 'active'
            && get(/databases/$(database)/documents/pilot_stocks/$(incoming().allocatedStockId)).data.instantBookingAgreed == true
            && get(/databases/$(database)/documents/pilot_stocks/$(incoming().allocatedStockId)).data.settlementMode == 'pay_on_arrival_agreed'
            && get(/databases/$(database)/documents/pilot_stocks/$(incoming().allocatedStockId)).data.serviceId == incoming().serviceId
          )
        )
        && incoming().paymentStatus == 'unpaid'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/journey_folders/$(incoming().folderId))
        && get(/databases/$(database)/documents/journey_folders/$(incoming().folderId)).data.ownerId == request.auth.uid
        && get(/databases/$(database)/documents/journey_folders/$(incoming().folderId)).data.status != 'archived'
        && hasAuthoritativeReservationPricing(incoming());

      allow update: if isVerifiedUser()
        && isValidId(reservationId)
        && isValidReservation(incoming())
        && incoming().clientId == existing().clientId
        && incoming().providerOwnerId == existing().providerOwnerId
        && incoming().providerId == existing().providerId
        && incoming().folderId == existing().folderId
        && incoming().serviceId == existing().serviceId
        && incoming().providerPrice == existing().providerPrice
        && incoming().amaroFee == existing().amaroFee
        && incoming().taxAmount == existing().taxAmount
        && incoming().totalAmount == existing().totalAmount
        && incoming().currency == existing().currency
        && incoming().pricingSnapshot == existing().pricingSnapshot
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (!(existing().status in ['cancelled', 'refunded']) || isAdmin())
        && (
          (existing().providerOwnerId == request.auth.uid
            && existing().status == 'pending_provider'
            && incoming().status in ['accepted', 'rejected', 'alternative_proposed']
            && incoming().paymentStatus == existing().paymentStatus
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'alternativeProposal', 'scheduledDate', 'scheduledTime', 'dispatchStatus', 'updatedAt']))
          || (existing().clientId == request.auth.uid
            && incoming().status in ['awaiting_payment', 'cancelled']
            && incoming().paymentStatus == existing().paymentStatus
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'alternativeProposal', 'updatedAt']))
          || (existing().clientId == request.auth.uid
            && existing().status in ['accepted', 'awaiting_payment', 'confirmed']
            && incoming().status == 'awaiting_payment'
            && incoming().paymentStatus == 'initiated'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'updatedAt']))
          || isAdmin()
        );

      allow delete: if isAdmin() && isValidId(reservationId);
    }

    // --- 7. AMARO PARTNERS (Influencers & Affiliates) ---
    match /partners/{partnerId} {
      allow get: if isValidId(partnerId) && (existing().status == 'active' || (isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin())));
      allow list: if existing().status == 'active' || (isSignedIn() && existing().ownerId == request.auth.uid) || isBootstrappedAdmin();

      allow create: if isVerifiedUser()
        && isValidId(partnerId)
        && isValidPartnerProfile(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().status == 'pending'
        && incoming().customCommissionRate == 0
        && incoming().visitsCount == 0
        && incoming().signupsCount == 0
        && incoming().reservationsCount == 0
        && incoming().confirmedCount == 0
        && incoming().paidAmountXof == 0
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(partnerId)
        && isValidPartnerProfile(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().referralCode == existing().referralCode
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (existing().ownerId == request.auth.uid
            && incoming().status == existing().status
            && incoming().customCommissionRate == existing().customCommissionRate
            && incoming().visitsCount == existing().visitsCount
            && incoming().signupsCount == existing().signupsCount
            && incoming().reservationsCount == existing().reservationsCount
            && incoming().confirmedCount == existing().confirmedCount
            && incoming().paidAmountXof == existing().paidAmountXof
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'channelUrl', 'updatedAt']))
          || isAdmin()
        );

      allow delete: if isAdmin() && isValidId(partnerId);
    }

    match /partner_referrals/{referralId} {
      allow get: if isSignedIn()
        && isValidId(referralId)
        && (existing().partnerOwnerId == request.auth.uid || existing().clientId == request.auth.uid || isAdmin());

      allow list: if isSignedIn()
        && (existing().partnerOwnerId == request.auth.uid || existing().clientId == request.auth.uid || isBootstrappedAdmin());

      allow create: if isVerifiedUser()
        && isValidId(referralId)
        && isValidPartnerReferral(incoming())
        && incoming().clientId == request.auth.uid
        && incoming().partnerOwnerId != request.auth.uid
        && incoming().status == 'pending'
        && incoming().clientPaid == false
        && incoming().providerSettled == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(referralId)
        && isValidPartnerReferral(incoming())
        && incoming().partnerId == existing().partnerId
        && incoming().partnerOwnerId == existing().partnerOwnerId
        && incoming().referralCode == existing().referralCode
        && incoming().reservationId == existing().reservationId
        && incoming().clientId == existing().clientId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (!(incoming().status in ['payable', 'paid']) || (incoming().clientPaid == true && incoming().providerSettled == true));

      allow delete: if isAdmin() && isValidId(referralId);
    }

    // --- 8. Centralized Notifications & Unified Dispatch Logs ---
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (existing().recipientId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().recipientId == request.auth.uid || isBootstrappedAdmin());

      allow create: if isVerifiedUser()
        && isValidId(notificationId)
        && isValidNotification(incoming())
        && incoming().senderId == request.auth.uid
        && incoming().read == false
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(notificationId)
        && isValidNotification(incoming())
        && incoming().recipientId == existing().recipientId
        && incoming().senderId == existing().senderId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (existing().recipientId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt']))
          || isAdmin()
        );

      allow delete: if isAdmin() && isValidId(notificationId);
    }

    match /notification_dispatches/{dispatchId} {
      allow get: if isAdmin() && isValidId(dispatchId);
      allow list: if isBootstrappedAdmin();
      allow create: if isVerifiedUser()
        && isValidId(dispatchId)
        && incoming().channel in ['in_app', 'email', 'sms', 'whatsapp']
        && incoming().status in ['created', 'sent', 'failed', 'channel_unconfigured'];
      allow update, delete: if isAdmin() && isValidId(dispatchId);
    }

    // --- 9. Cultural Stories ---
    match /cultural_stories/{storyId} {
      allow get: if isValidId(storyId) && (existing().moderationStatus == 'approved' || (isSignedIn() && (existing().authorId == request.auth.uid || isAdmin())));
      allow list: if existing().moderationStatus == 'approved' || (isSignedIn() && existing().authorId == request.auth.uid) || isBootstrappedAdmin();

      allow create: if isVerifiedUser()
        && isValidId(storyId)
        && isValidCulturalStory(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().moderationStatus == 'pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(storyId)
        && isValidCulturalStory(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(storyId);
    }

    // --- 10. System Settings ---
    match /system_settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;

      allow create: if isAdmin()
        && isValidId(settingId)
        && isValidSystemSetting(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(settingId)
        && isValidSystemSetting(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(settingId);
    }

    // --- 11. Append-Only Administrative Audit Logs ---
    match /audit_logs/{logId} {
      allow get: if isAdmin() && isValidId(logId);
      allow list: if isBootstrappedAdmin();

      allow create: if isValidId(logId)
        && isValidAuditLog(incoming())
        && incoming().createdAt == request.time
        && (
          (isAdmin() && incoming().actorId == request.auth.uid)
          || (isVerifiedUser() && incoming().action == 'CLIENT_ACCOUNT_DELETED_COMPLIANT')
        );

      allow update, delete: if false;
    }

    // --- 12. Reservation-Scoped Identity Verification & Private Encrypted Vault ---
    match /identity_verifications/{reservationId} {
      allow get: if isSignedIn()
        && isValidId(reservationId)
        && (
          existing().clientId == request.auth.uid
          || (existing().providerOwnerId != 'manual_concierge' && existing().providerOwnerId == request.auth.uid)
          || isAdmin()
        );

      allow list: if isSignedIn()
        && (
          existing().clientId == request.auth.uid
          || (existing().providerOwnerId != 'manual_concierge' && existing().providerOwnerId == request.auth.uid)
          || isBootstrappedAdmin()
        );

      allow create: if isVerifiedUser()
        && isValidId(reservationId)
        && isValidIdentityVerification(incoming())
        && incoming().reservationId == reservationId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          incoming().clientId == request.auth.uid
          || (incoming().providerOwnerId != 'manual_concierge' && incoming().providerOwnerId == request.auth.uid && incoming().status == 'requested')
          || isAdmin()
        );

      allow update: if isVerifiedUser()
        && isValidId(reservationId)
        && isValidIdentityVerification(incoming())
        && incoming().reservationId == existing().reservationId
        && incoming().folderId == existing().folderId
        && incoming().clientId == existing().clientId
        && incoming().providerOwnerId == existing().providerOwnerId
        && incoming().providerId == existing().providerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (existing().clientId == request.auth.uid
            && (incoming().status != 'accepted' || existing().status == 'accepted'))
          || (existing().providerOwnerId != 'manual_concierge'
            && existing().providerOwnerId == request.auth.uid
            && incoming().consentGiven == existing().consentGiven
            && incoming().providerAuthorized == existing().providerAuthorized)
          || isAdmin()
        );

      allow delete: if isValidId(reservationId) && ((isVerifiedUser() && existing().clientId == request.auth.uid) || isAdmin());

      match /private_vault/{vaultId} {
        allow list: if false;

        allow get: if isVerifiedUser()
          && vaultId == 'files'
          && exists(/databases/$(database)/documents/identity_verifications/$(reservationId))
          && (
            get(/databases/$(database)/documents/identity_verifications/$(reservationId)).data.clientId == request.auth.uid
            || (
              get(/databases/$(database)/documents/identity_verifications/$(reservationId)).data.providerOwnerId != 'manual_concierge'
              && get(/databases/$(database)/documents/identity_verifications/$(reservationId)).data.providerOwnerId == request.auth.uid
              && get(/databases/$(database)/documents/identity_verifications/$(reservationId)).data.consentGiven == true
              && get(/databases/$(database)/documents/identity_verifications/$(reservationId)).data.providerAuthorized == true
              && get(/databases/$(database)/documents/identity_verifications/$(reservationId)).data.status in ['shared_with_provider', 'accepted', 'pending_verification']
            )
          );

        allow create: if isVerifiedUser()
          && vaultId == 'files'
          && isValidIdentityVault(incoming())
          && incoming().reservationId == reservationId
          && incoming().clientId == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isVerifiedUser()
          && vaultId == 'files'
          && isValidIdentityVault(incoming())
          && incoming().reservationId == reservationId
          && incoming().clientId == request.auth.uid
          && incoming().clientId == existing().clientId
          && (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time)
          && incoming().updatedAt == request.time;

        allow delete: if isVerifiedUser()
          && vaultId == 'files'
          && exists(/databases/$(database)/documents/identity_verifications/$(reservationId))
          && (
            get(/databases/$(database)/documents/identity_verifications/$(reservationId)).data.clientId == request.auth.uid
            || isAdmin()
          );
      }

      match /access_logs/{logId} {
        allow get, list: if isSignedIn()
          && exists(/databases/$(database)/documents/identity_verifications/$(reservationId))
          && (
            get(/databases/$(database)/documents/identity_verifications/$(reservationId)).data.clientId == request.auth.uid
            || (
              get(/databases/$(database)/documents/identity_verifications/$(reservationId)).data.providerOwnerId != 'manual_concierge'
              && get(/databases/$(database)/documents/identity_verifications/$(reservationId)).data.providerOwnerId == request.auth.uid
            )
            || isAdmin()
          );

        allow create: if isVerifiedUser()
          && isValidId(logId)
          && isValidIdentityAccessLog(incoming())
          && incoming().reservationId == reservationId
          && incoming().actorId == request.auth.uid
          && incoming().createdAt == request.time;

        allow update, delete: if false;
      }
    }

    // --- 13. Pilot Partners Confidential Conventioning CRM (Strictly Admin-Only) ---
    match /pilot_partners/{pilotId} {
      allow get: if isAdmin() && isValidId(pilotId);
      allow list: if isBootstrappedAdmin();

      allow create: if isAdmin()
        && isValidId(pilotId)
        && isValidPilotPartner(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isAdmin()
        && isValidId(pilotId)
        && isValidPilotPartner(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;

      allow delete: if isAdmin() && isValidId(pilotId);
    }

    // --- 14. Confirmed Pilot Stocks (Hotels & Transport Anti-Double-Booking) ---
    match /pilot_stocks/{stockId} {
      allow get: if isValidId(stockId)
        && (
          existing().status == 'active'
          || (isSignedIn() && (existing().providerOwnerId == request.auth.uid || isAdmin()))
        );

      allow list: if existing().status == 'active'
        || (isSignedIn() && existing().providerOwnerId == request.auth.uid)
        || isBootstrappedAdmin();

      allow create: if isAdmin()
        && isValidId(stockId)
        && isValidPilotStock(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isValidId(stockId)
        && isValidPilotStock(incoming())
        && incoming().pilotId == existing().pilotId
        && incoming().serviceId == existing().serviceId
        && incoming().providerId == existing().providerId
        && incoming().providerOwnerId == existing().providerOwnerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin()
          || (
            existing().providerOwnerId != 'manual_concierge'
            && existing().providerOwnerId == request.auth.uid
            && incoming().updatedBy == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'totalUnits', 'bookedUnits', 'startDate', 'endDate', 'expiresAt',
              'status', 'updatedBy', 'updatedAt'
            ])
          )
          || (
            incoming().diff(existing()).affectedKeys().hasOnly(['bookedUnits', 'lastReservationId', 'updatedAt'])
            && 'lastReservationId' in incoming()
            && isValidId(incoming().lastReservationId)
            && existsAfter(/databases/$(database)/documents/reservations/$(incoming().lastReservationId))
            && getAfter(/databases/$(database)/documents/reservations/$(incoming().lastReservationId)).data.clientId == request.auth.uid
            && getAfter(/databases/$(database)/documents/reservations/$(incoming().lastReservationId)).data.allocatedStockId == stockId
          )
        );

      allow delete: if isAdmin() && isValidId(stockId);
    }

    // --- 15. Editable Legal, Charter, Emergency & Institutional Content ---
    match /platform_content/{docId} {
      allow get, list: if true;
      allow create, update: if isAdmin()
        && isValidId(docId)
        && incoming().slug is string && incoming().slug.size() <= 80
        && incoming().title is string && incoming().title.size() <= 200
        && incoming().version is string && incoming().version.size() <= 40
        && incoming().body is string && incoming().body.size() <= 20000
        && incoming().isProvisional is bool
        && incoming().ownerValidated is bool
        && incoming().updatedBy == request.auth.uid;
      allow delete: if isAdmin() && isValidId(docId);
    }

    // --- 16. Client Account Governance (Abandonment Risk & Manual Block) ---
    match /account_governance/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isBootstrappedAdmin();
      allow create, update, delete: if isAdmin() && isValidId(userId);
    }

    // --- 17. Read-Only Revocable Folder Shares & Visitor Suggestions ---
    match /folder_shares/{shareId} {
      allow get: if isValidId(shareId)
        && (existing().revoked == false || (isSignedIn() && (existing().ownerId == request.auth.uid || isAdmin())));
      allow list: if isSignedIn() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());

      allow create: if isVerifiedUser()
        && isValidId(shareId)
        && incoming().ownerId == request.auth.uid
        && isValidId(incoming().folderId)
        && incoming().folderTitle is string && incoming().folderTitle.size() <= 160
        && incoming().snapshotSummary is string && incoming().snapshotSummary.size() <= 6000
        && incoming().suggestions is list && incoming().suggestions.size() <= 50
        && incoming().revoked == false;

      allow update: if isValidId(shareId)
        && incoming().folderId == existing().folderId
        && incoming().ownerId == existing().ownerId
        && (
          (isVerifiedUser() && (existing().ownerId == request.auth.uid || isAdmin()))
          || (
            existing().revoked == false
            && incoming().revoked == false
            && incoming().diff(existing()).affectedKeys().hasOnly(['suggestions', 'updatedAt'])
            && incoming().suggestions is list
            && incoming().suggestions.size() <= 50
          )
        );

      allow delete: if isVerifiedUser() && isValidId(shareId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    // --- 18. Verified Post-Stay Traveler Reviews ---
    match /traveler_reviews/{reviewId} {
      allow get: if isValidId(reviewId)
        && (existing().moderationStatus == 'approved' || (isSignedIn() && (existing().clientId == request.auth.uid || isAdmin())));
      allow list: if existing().moderationStatus == 'approved'
        || (isSignedIn() && existing().clientId == request.auth.uid)
        || isBootstrappedAdmin();

      allow create: if isVerifiedUser()
        && isValidId(reviewId)
        && incoming().clientId == request.auth.uid
        && isValidId(incoming().reservationId)
        && isValidId(incoming().serviceId)
        && incoming().rating is int && incoming().rating >= 1 && incoming().rating <= 5
        && incoming().comment is string && incoming().comment.size() >= 3 && incoming().comment.size() <= 2000
        && incoming().moderationStatus == 'pending'
        && exists(/databases/$(database)/documents/reservations/$(incoming().reservationId))
        && get(/databases/$(database)/documents/reservations/$(incoming().reservationId)).data.clientId == request.auth.uid
        && get(/databases/$(database)/documents/reservations/$(incoming().reservationId)).data.status == 'confirmed';

      allow update, delete: if isAdmin() && isValidId(reviewId);
    }

    // --- 19. Private Post-Stay Thank-You Notes for Providers ---
    match /provider_thank_yous/{thankYouId} {
      allow get: if isSignedIn()
        && isValidId(thankYouId)
        && (
          existing().clientId == request.auth.uid
          || (existing().providerOwnerId == request.auth.uid && existing().status == 'transmitted_to_provider')
          || isAdmin()
        );
      allow list: if isSignedIn()
        && (
          existing().clientId == request.auth.uid
          || (existing().providerOwnerId == request.auth.uid && existing().status == 'transmitted_to_provider')
          || isBootstrappedAdmin()
        );

      allow create: if isVerifiedUser()
        && isValidId(thankYouId)
        && incoming().clientId == request.auth.uid
        && incoming().message is string && incoming().message.size() >= 3 && incoming().message.size() <= 1500
        && incoming().status == 'pending_admin';

      allow update, delete: if isAdmin() && isValidId(thankYouId);
    }

    // --- 20. Minimal Non-PII Financial Archives & Mobile Money TxRef Uniqueness Locks ---
    match /financial_archives/{archiveId} {
      allow get: if isAdmin() && isValidId(archiveId);
      allow list: if isBootstrappedAdmin();

      allow create: if isVerifiedUser()
        && isValidId(archiveId)
        && incoming().recordKind in ['dossier_fee', 'reservation_payment']
        && incoming().transactionRef is string && incoming().transactionRef.size() >= 3 && incoming().transactionRef.size() <= 100
        && incoming().amount is number && incoming().amount >= 0;

      allow update, delete: if isAdmin() && isValidId(archiveId);
    }
  }
}
